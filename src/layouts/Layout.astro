---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Christian Paul Reinoso — Senior Software Engineer & Tech Lead",
  description =
    "Senior Software Engineer y Tech Lead. Banca y fintech con React Native y NestJS. Fundador de RinnoTec y RinnFac.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Christian Reinoso, Tech Lead, React Native, NestJS, Thoughtworks, RinnoTec, RinnFac, Ecuador"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen font-sans antialiased selection:bg-accent/25 selection:text-accent"
  >
    <!-- Ambient: accent glow + engineering grid, theme-aware -->
    <div
      class="pointer-events-none fixed inset-0 -z-10 bg-grid bg-background"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none fixed inset-0 -z-20 bg-[radial-gradient(ellipse_70%_50%_at_75%_-10%,var(--accent),transparent_65%)] opacity-[0.13]"
      aria-hidden="true"
    >
    </div>
    <slot />
  </body>
</html>

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    // Dark-first: this is an engineering workstation, it lives in the dark.
    return "dark";
  };
  const isDark = getThemePreference() !== "light";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    scroll-behavior: smooth;
  }

  body {
    transition:
      background-color 0.3s var(--ease-out-strong, ease-out),
      color 0.3s var(--ease-out-strong, ease-out);
  }
</style>
